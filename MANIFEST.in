# sdist に入れる追加のファイル。sdist を展開した先で python -m pytest が全部通るようにする
# （tests/test_docs.py が CLAUDE.md・README・ARCHITECTURE.md・docs/ を、
#   tests/test_quality_gate.py が scripts/ を、tests/test_harness.py が harness/ と .claude/settings.json を読む）。
# wheel には影響しない。
include CHANGELOG.md README.ja.md ARCHITECTURE.md CLAUDE.md .claude/settings.json
graft docs
graft scripts
graft tests
graft harness
global-exclude __pycache__ *.py[cod]
